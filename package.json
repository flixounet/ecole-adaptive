{
  "name": "ecole-adaptive",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --config apps/student/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/student/vite.config.ts",
    "preview": "vite preview --config apps/student/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "format": "prettier --write apps/student/src shared apps/student/vite.config.ts vitest.config.ts",
    "lint": "eslint apps/student/src apps/student/build shared apps/student/vite.config.ts vitest.config.ts playwright.config.ts e2e --max-warnings 0 scripts teacher/static/studio.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "dexie": "^4.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.0.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
