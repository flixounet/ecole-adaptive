{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ecole-adaptive.local/schemas/question-bank-1.0.json",
  "title": "Ecole Adaptive Question Bank 1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
    },
    "chapter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "grade": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
    },
    "studentIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
      },
      "uniqueItems": true
    },
    "isDemo": {
      "type": "boolean"
    },
    "sourceNotice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "\\S"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "chapter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "\\S"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "\\S"
          }
        },
        "required": ["id", "name"]
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "\\S"
          },
          "kind": {
            "enum": ["fixture", "image", "pdf"]
          }
        },
        "required": ["id", "label", "kind"]
      }
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "questionCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/definitions/question"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "subject",
    "chapter",
    "grade",
    "language",
    "studentIds",
    "isDemo",
    "sourceNotice",
    "skills",
    "sourceRefs",
    "durationMinutes",
    "questionCount",
    "questions"
  ],
  "definitions": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "chapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "skillIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "uniqueItems": true
        },
        "difficulty": {
          "type": "integer",
          "enum": [1, 2, 3, 4]
        },
        "points": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "questionType": {
          "enum": ["numeric", "decimal", "short_text", "expression", "multiple_choice"]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "acceptedAnswers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "correctAnswer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "explanationSteps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "\\S"
          }
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "secondHint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "memoryRule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "commonMistake": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000,
          "pattern": "\\S"
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
          },
          "uniqueItems": true
        },
        "estimatedSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7200
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              }
            },
            "required": ["id", "text"]
          }
        }
      },
      "required": [
        "id",
        "subject",
        "chapter",
        "skillIds",
        "difficulty",
        "points",
        "questionType",
        "question",
        "instruction",
        "acceptedAnswers",
        "correctAnswer",
        "explanationSteps",
        "hint",
        "secondHint",
        "memoryRule",
        "commonMistake",
        "sourceRefs",
        "estimatedSeconds"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "questionType": {
                "const": "multiple_choice"
              }
            },
            "required": ["questionType"]
          },
          "then": {
            "required": ["choices"],
            "properties": {
              "choices": {}
            }
          },
          "else": {
            "not": {
              "required": ["choices"],
              "properties": {
                "choices": {}
              }
            }
          }
        }
      ]
    }
  }
}
